+
+def xlsx_bytes(rows):
+    wb = Workbook()
+    ws = wb.active
+    for r in rows:
+        ws.append(r)
+    for excel_row in ws.iter_rows():
+        for cell in excel_row:
+            if isinstance(cell.value, str):
+                cell.data_type = "s"  # keep "=..." as literal text, not a formula
+    buf = BytesIO()
+    wb.save(buf)
+    return buf.getvalue()
